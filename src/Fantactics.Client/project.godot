; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fantactics"
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://App/Main.tscn"
config/icon="res://icon.svg"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Fantactics.Client"
project/solution_directory="../"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"

[input]

confirm={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
cancel={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2), Object(InputEventKey,"physical_keycode":4194305)]
}
submit={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194309)]
}
wait_action={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
delay_action={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
queue_modifier={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
skip_animation={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
quicksave={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194336)]
}
quickload={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194340)]
}
toggle_debug={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194332)]
}
ability_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
ability_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
ability_3={
