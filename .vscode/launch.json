{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Play",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${config:godotTools.editorPath.godot4}",
      "args": ["--path", "${workspaceFolder}/src/Fantactics.Client"],
      "cwd": "${workspaceFolder}/src/Fantactics.Client",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Open Godot Editor",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${config:godotTools.editorPath.godot4}",
      "args": ["--path", "${workspaceFolder}/src/Fantactics.Client", "--editor"],
      "cwd": "${workspaceFolder}/src/Fantactics.Client",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Server",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Fantactics.Server/bin/Debug/net8.0/Fantactics.Server.dll",
      "cwd": "${workspaceFolder}/src/Fantactics.Server",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" },
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Attach to Godot",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ],
  "compounds": [
    {
      "name": "Server + Play",
      "configurations": ["Server", "Play"]
    }
  ]
}
